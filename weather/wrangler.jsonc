{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baltic-weather",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "weather.seasync.co", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
